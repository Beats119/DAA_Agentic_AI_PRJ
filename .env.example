# Copy to .env and adjust. Never commit real secrets (there are none by design:
# this project uses no API keys — all inference is local via Ollama).

# Local Ollama endpoint (loopback only by default)
OLLAMA_URL=http://127.0.0.1:11434

# Where immutable run artifacts are stored
ARTIFACT_DIR=./artifacts

# SQLite database for run metadata / index
DB_PATH=./autograder.db

# Sandbox strictness: strict | permissive (permissive only for debugging)
SANDBOX_POLICY=strict
