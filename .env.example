# Copy to .env and adjust. Never commit real secrets (there are none by design:
# this project uses no API keys — all inference is local via Ollama).
#
# This file lists EXACTLY the environment variables the code reads
# (verified by grep over autograder/). Anything else is ignored.

# Local Ollama endpoint (loopback only by default)
OLLAMA_URL=http://127.0.0.1:11434

# Where run artifacts and the SQLite run database are stored
# (web app launcher; the CLI takes explicit paths instead)
ARTIFACT_DIR=./artifacts

# Optional: path to a JSON file with sandbox policy overrides
# (see SandboxPolicy in autograder/app/sandbox/policy.py).
# Unset = built-in policy with all mandatory enforcement on.
#AUTOGRADER_SANDBOX_POLICY=/path/to/sandbox-policy.json

# Optional: enable the supplementary LLM feedback audit (the
# `feedback_check` model task) on top of the authoritative deterministic
# feedback verifier. Accepts 1/true/yes/on. Default: off.
#AUTOGRADER_FEEDBACK_LLM_CHECK=0
